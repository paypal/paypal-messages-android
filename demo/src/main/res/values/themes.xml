<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme using MaterialComponents for better Material3 compatibility -->
    <style name="Theme.PayPalMessages" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Enable view binding / view inflation compatibility -->
        <item name="android:windowBackground">@color/white</item>
    </style>
    
    <!-- Special theme for the PayPal Modal Activity -->
    <style name="Theme.PayPalModal" parent="Theme.MaterialComponents.Light.Dialog">
        <!-- Make the background transparent -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <!-- Remove title and borders -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <!-- Full screen modal -->
        <item name="android:windowFullscreen">false</item>
        <!-- Animation -->
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
        <!-- System UI -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>